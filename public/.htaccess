# Web server settings for the static site on Namecheap shared hosting
# (LiteSpeed, reads Apache rules). The build copies this file into out/ and the
# deploy workflow uploads it to public_html with the rest of the site.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# The upload tool's record of what it uploaded; not part of the site.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

RewriteEngine On

# Leave SSL certificate checks alone, so the free certificate keeps renewing.
RewriteRule ^\.well-known/ - [L]

# One address for everyone: https and no "www". Skipped for the server's own
# internal hops (such as showing 404.html), so a missing page stays a 404.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# Social-sharing images have no file extension.
<FilesMatch "^(opengraph|twitter)-image$">
  ForceType image/png
</FilesMatch>
AddType application/manifest+json .webmanifest

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Scripts, styles and fonts have a content hash in their name, so they never change.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Pages and their navigation data: always check for a newer version.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Photos can be replaced from /admin under the same name.
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>
