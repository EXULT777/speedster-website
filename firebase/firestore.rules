rules_version = '2';

// Security rules for the Firestore database that stores contact-form leads.
// Paste into Firebase console → Firestore Database → Rules, after replacing
// PASTE_YOUR_ADMIN_UID_HERE with the User UID shown in Authentication → Users.
//
// Anyone may add a lead through the contact form; only the owner's account may
// read or delete leads. Everything else is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';
    }

    function shortText(field, max) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() > 0
        && request.resource.data[field].size() <= max;
    }

    function optionalText(field, max) {
      return !(field in request.resource.data) || shortText(field, max);
    }

    match /leads/{leadId} {
      allow read, delete: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'city', 'service', 'vehicle', 'message', 'createdAt'])
        && shortText('name', 120)
        && shortText('phone', 20)
        && optionalText('email', 200)
        && shortText('city', 60)
        && shortText('service', 120)
        && optionalText('vehicle', 120)
        && shortText('message', 5000)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt > request.time - duration.value(10, 'm')
        && request.resource.data.createdAt < request.time + duration.value(10, 'm');
    }
  }
}
